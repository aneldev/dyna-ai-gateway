{
  // The compiler options of every package of the workspace. A package's tsconfig.json extends this file and adds only
  // what is its own: rootDir, outDir, include and exclude.
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "esnext",
    "target": "es6",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "sourceMap": false,
    "declaration": false,
    "allowJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noErrorTruncation": true,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "jest"
    ]
  },
  "compileOnSave": false
}
