{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "sourceMap": true,
    "declaration": true,
    "declarationDir": "./dist/",
    "declarationMap": true,
    "emitDeclarationOnly": true,
  },
  // The published declarations: no tests
  "exclude": [
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/tests/**",
  ],
}
