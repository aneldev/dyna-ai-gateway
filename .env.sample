# Provider keys: the real-provider tests (*.real.test.ts; a test is skipped while its key is empty) and the sandbox (src/dev-sandbox), which runs a test's config
AIGATEWAY_TEST_OPENAI_API_KEY=
AIGATEWAY_TEST_ANTHROPIC_API_KEY=
# Bedrock: an Amazon Bedrock API key (bearer token) and the region the models are enabled in (empty = AWS_REGION, else us-east-1)
AIGATEWAY_TEST_BEDROCK_API_KEY=
AIGATEWAY_TEST_BEDROCK_REGION=
AIGATEWAY_TEST_GOOGLE_API_KEY=
AIGATEWAY_TEST_MISTRAL_API_KEY=
# Optional: the provider model ids those tests call (defaults: gpt-5-mini, claude-haiku-4-5-20251001)
AIGATEWAY_TEST_OPENAI_MODEL=
AIGATEWAY_TEST_ANTHROPIC_MODEL=
# Optional: the embedding model of the KB tests (default: text-embedding-3-small); it uses AIGATEWAY_TEST_OPENAI_API_KEY
AIGATEWAY_TEST_OPENAI_EMBEDDING_MODEL=
